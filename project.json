{
	"debug-info": "full",
	"cpu": "native",
	"single-module": true,
	"x86cpu": "native",
	"x86vec": "default",
	"fp-math": "strict",
	"sanitize": "none",

	"sources": [ 

		"src/builtin/*",
		"src/types/*",

		"src/env.c3",
		"src/rounding.c3",

		"src/integer/**",
		"src/vector/*",
		"src/softfloat/*",
		"src/softfloat/arithmetic/*",
		"src/softfloat/test/*",
		"src/ap/**"
	],

	"targets": {
		"main": {
			"sources": [ "main.c3" ],
			"type": "executable",
			"opt": "O0",
			"safe": true,
			"dependency-search-paths": [ "test/lib/" ],
			"dependencies": [ "gmp", "mpfr" ]
		},

		"fast": {
			"sources": [ "main.c3" ],
			"type": "executable",
			"unroll-loops" : true,   
			"loop-vectorize" : true, 
			"slp-vectorize" : true,  
			"merge-functions" : true,
			"optlevel": "max",
			"safe": false
		},

		"flt-test": {
			"type": "test",
			"sources": [
				"src/softfloat/*"
			],
			"test-sources": [ "src/softfloat/test/*" ],
			"dependency-search-paths": [ "test/lib/" ],
			"dependencies": [ "gmp", "mpfr" ]
		}
	}
}

